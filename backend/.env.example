# Configuração do servidor
PORT=3000
CORS_ORIGIN=http://localhost:5174

# Segredo usado para assinar tokens JWT — gere um valor aleatório forte
# (ex: openssl rand -hex 64) e nunca reutilize entre ambientes.
JWT_SECRET=troque_este_valor_por_um_segredo_aleatorio_forte

# SMTP para envio de códigos OTP por e-mail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-de-app

# Bootstrap do primeiro super_admin (usado por setup-admin.js)
ADMIN_EMAIL=admin@seudominio.com
ADMIN_PASSWORD=defina_uma_senha_forte_aqui
